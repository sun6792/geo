# ── Application ──────────────────────────────────────────────
APP_NAME=GEO AI Platform
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://geoai:geoai@localhost:5432/geoai_platform
DATABASE_URL_SYNC=postgresql://geoai:geoai@localhost:5432/geoai_platform

# ── Chroma Vector Store ──────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Storage ─────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── LLM Providers ────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Embedding ────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
